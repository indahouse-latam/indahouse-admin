# ===========================================
# Indahouse Admin – QA (rama develop)
# ===========================================
# Copia a .env.local para desarrollo local.
# En Vercel Preview (develop) configura estas variables en Environment Variables.
# Todo proveedor privado en NEXT_PUBLIC queda visible en el navegador; restringelo por dominio y cuota.

# Backend API (QA)
NEXT_PUBLIC_API_URL=https://api-qa.indahouse.com.co/api/v1

# App URL (usado en callbacks, etc.)
NEXT_PUBLIC_APP_URL=https://admin-qa.tudominio.com

# Wallet API (Nyx / integración billetera)
NEXT_PUBLIC_WALLET_URL=https://nyx-wallet-api-qa.ledgit.tech
NEXT_PUBLIC_WALLET_API_KEY=your-qa-wallet-api-key

# Google Maps (autocomplete direcciones)
NEXT_PUBLIC_GOOGLE_MAPS_KEY=your-google-maps-key

# Entorno: QA usa Polygon Amoy (testnet)
NEXT_PUBLIC_APP_ENV=qa
NEXT_PUBLIC_POLYGON_AMOY_RPC_URL=https://polygon-amoy.drpc.org
