# ===========================================
# Indahouse Admin – PRODUCTION (rama main)
# ===========================================
# No subas valores reales a repo. Configura en Vercel → Project → Settings → Environment Variables
# para el entorno "Production" (deploys desde main).
# Todo proveedor privado en NEXT_PUBLIC queda visible en el navegador; restringelo por dominio y cuota.

# Backend API (Production)
NEXT_PUBLIC_API_URL=https://api.indahouse.com.co/api/v1

# App URL
NEXT_PUBLIC_APP_URL=https://indahouse-admin.vercel.app

# Wallet API (Production)
NEXT_PUBLIC_WALLET_URL=https://nyx-wallet-api.ledgit.tech
NEXT_PUBLIC_WALLET_API_KEY=<placeholder-production-wallet-api-key>

# Google Maps (mismo key o uno específico producción)
NEXT_PUBLIC_GOOGLE_MAPS_KEY=your-production-google-maps-key

# Entorno: Production usa Polygon Mainnet
NEXT_PUBLIC_APP_ENV=production
NEXT_PUBLIC_POLYGON_AMOY_RPC_URL=https://polygon-amoy.drpc.org
